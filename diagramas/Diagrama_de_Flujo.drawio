        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph Fase_Inicio [FASE 1: ARRANQUE Y AUTOTEST LIVIANO]\n        Power([Encendido]) --&gt; Boot[\&quot;Cargar Bootloader\\n(BRAM interna, siempre disponible,\\nno depende de Flash externa)\&quot;]\n        Boot --&gt; InitHW[\&quot;Inicializar UART y Bus CSR\&quot;]\n        InitHW --&gt; SelfTest[\&quot;Autotest liviano de SPI-RAM / SPI-Flash:\\nescribir un patrón conocido en 1 dirección\\ny leerlo de vuelta (NO barrido completo)\&quot;]\n        SelfTest --&gt; HWok{\&quot;¿SPI-RAM y SPI-Flash\\nresponden correctamente?\&quot;}\n        HWok -- No --&gt; HardFail[\&quot;FALLO CRÍTICO DE HARDWARE:\\nrutina de error mínima guardada en BRAM\\n(independiente de Flash) + log por UART\&quot;]\n        HWok -- Si --&gt; LoadMenuAssets[Cargar assets del menú desde Flash]\n        LoadMenuAssets --&gt; Checksum[\&quot;Calcular checksum del menú cargado\\ny compararlo con el valor esperado\\nguardado junto al asset\&quot;]\n        Checksum --&gt; ChkOk{\&quot;¿Checksum coincide?\&quot;}\n        ChkOk -- No --&gt; SoftFail[\&quot;ADVERTENCIA (no bloqueante):\\nmostrar menú de emergencia desde BRAM\\n+ log por UART. El sistema SIGUE\&quot;]\n        ChkOk -- Si --&gt; ScanPorts\n        SoftFail --&gt; ScanPorts\n        HardFail --&gt; STOP([\&quot;Sistema detenido.\\nSi Display también falló, el único\\ndiagnóstico disponible es el log por UART\&quot;])\n    end\n\n    subgraph Fase_Perifericos [FASE 2: GESTIÓN DE PERIFÉRICOS]\n        ScanPorts[\&quot;Escanear Puertos:\\nleer registro ID CSR de cada puerto\&quot;] --&gt; IsConnected{\&quot;¿ID CSR != 0?\\n(0 = puerto vacío)\&quot;}\n        IsConnected -- Si --&gt; ReadSignature[\&quot;Leer firma del dispositivo\\n(PS2: comando real 0xF2 &#39;read device ID&#39;,\\nsoportado por teclado y mouse)\&quot;]\n        IsConnected -- No --&gt; LED_Off[\&quot;Mantener LED apagado\\n(= puerto sin dispositivo)\&quot;]\n        ReadSignature --&gt; IdentifyType{\&quot;¿Qué firma reportó?\&quot;}\n        IdentifyType -- \&quot;Teclado o Mouse PS2\&quot; --&gt; LED_On[\&quot;Encender LED del puerto\\n(= dispositivo detectado y reconocido)\&quot;]\n        IdentifyType -- \&quot;NES vía adaptador\\n(sin firma estándar real)\&quot; --&gt; AssumeNES[\&quot;[PENDIENTE] Definir cómo se detecta NES:\\nopción A: adaptador emula firma PS2 falsa\\nopción B: solo detección de presencia\\n(pin dedicado) + confirmación manual en menú\&quot;]\n        AssumeNES --&gt; LED_On\n        LED_On &amp; LED_Off --&gt; LoadIcons[\&quot;Cargar íconos desde Flash\\n(teclado / gamepad / mouse)\&quot;]\n    end\n\n    subgraph Fase_Menu [FASE 3: NAVEGACIÓN Y SELECCIÓN]\n        LoadIcons --&gt; ShowMenu[Mostrar Paneles: Single / Multi-Local / Multi-Link]\n        ShowMenu --&gt; ResetTimer[\&quot;Timer_Idle = 0\\n(valor inicial; se reinicia con cualquier actividad)\&quot;]\n        ResetTimer --&gt; Idle{\&quot;¿Entrada de Control?\&quot;}\n        Idle -- No --&gt; Tick[\&quot;Timer_Idle++\\n(incrementa mientras no hay input;\\nesto es lo que &#39;escucha&#39; el puerto activo)\&quot;]\n        Tick --&gt; TimerCheck{\&quot;¿Timer_Idle &gt; 30s?\&quot;}\n        TimerCheck -- Si --&gt; DemoMode[Modo Demo / Animación]\n        TimerCheck -- No --&gt; Idle\n\n        DemoMode -- \&quot;Cualquier input llega\&quot; --&gt; ExitDemo[\&quot;Detener animación,\\nredibujar el menú (ShowMenu)\&quot;]\n        ExitDemo --&gt; ResetTimer\n\n        Idle -- Si --&gt; Translate[\&quot;Traducir código a comando:\\nUp, Down, L, R, A, B, Start\&quot;]\n        Translate --&gt; Nav{¿Comando?}\n        Nav -- L / R --&gt; SwitchPanel[Cambiar Panel de Modo]\n        Nav -- A --&gt; Validate[Verificar Requerimientos de Modo]\n        Nav -- B --&gt; ShowMenu\n\n        Validate --&gt; MultiCheck{\&quot;¿Suficientes controles?\&quot;}\n        MultiCheck -- No --&gt; ErrorPrompt[\&quot;Notificación: Faltan Controles\&quot;]\n        ErrorPrompt --&gt; WaitB[Esperar Botón B para Salir]\n        WaitB --&gt; ShowMenu\n\n        MultiCheck -- Si --&gt; ModeDecide{¿Qué Modo?}\n        ModeDecide -- Multi-Link --&gt; Lobby[Sala de Espera: Lobby]\n        ModeDecide -- Single / Multi-Local --&gt; LoadGame[Cargar Binario de Juego a RAM]\n\n        Lobby --&gt; ReadySync[\&quot;Esperar que todos marquen LISTO\&quot;]\n        ReadySync --&gt; LoadGame\n    end\n\n    subgraph Fase_Ejecucion [FASE 4: CARGA Y EJECUCIÓN]\n        SwitchPanel --&gt; ResetTimer\n\n        LoadGame --&gt; RunGame[Ejecutar Juego]\n        RunGame --&gt; Monitoring[\&quot;Escuchar Cambio de ID CSR\\n(hot-plugging)\&quot;]\n        Monitoring --&gt; HotPlug{\&quot;¿ID CSR de algún periférico cambió?\&quot;}\n        HotPlug -- Si --&gt; PauseGame[\&quot;Pausar &amp; Notificar:\\nreanudar bloqueado\&quot;]\n        HotPlug -- No --&gt; RunGame\n\n        PauseGame --&gt; Reconnect[\&quot;Esperar Reconexión o Salir al Menú\&quot;]\n        Reconnect -- Reconectado --&gt; RunGame\n        Reconnect -- Salir --&gt; ShowMenu\n    end\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mOkqRXmOCxhVhKbqHQ2n-2">
          <mxCell connectable="0" parent="mOkqRXmOCxhVhKbqHQ2n-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
